.category-type-tabs { margin-bottom: 24rpx; }

.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 24rpx;
}

.input-row--margin { margin-top: 12rpx; }

.input-row__input,
.input-row__icon {
  flex: 1;
  height: 88rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.input-row__icon {
  max-width: 140rpx;
  text-align: center;
}

.input-row__btn {
  flex-shrink: 0;
  width: 160rpx;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 28rpx !important;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.category-item {
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-item--active {
  background: var(--color-primary-light);
  border: 1rpx solid rgba(7, 193, 96, 0.25);
}
