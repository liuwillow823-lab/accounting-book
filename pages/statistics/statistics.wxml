<view class="container stats-page">
  <view class="card stats-header stats-header--tall">
    <view class="stats-header__topline">
      <text class="section-title stats-header__title">{{ title }}</text>
      <view class="stats-top-switch">
        <view class="stats-top-switch__item {{ type === 'expense' ? 'stats-top-switch__item--active' : '' }}" data-type="expense" bindtap="onTypeChange">支出</view>
        <view class="stats-top-switch__item {{ type === 'income' ? 'stats-top-switch__item--active' : '' }}" data-type="income" bindtap="onTypeChange">收入</view>
      </view>
    </view>
    <view class="stats-header__secondline">
      <view class="stats-meta">
        <text class="stats-header__sub">共 {{ totalCount }} 笔</text>
      </view>
      <view class="filter-trigger" bindtap="onFilterTap">
        <text class="filter-trigger__text">{{ filterLabel }}</text>
        <text class="filter-trigger__arrow">▾</text>
      </view>
    </view>
  </view>

  <view class="card stats-switcher-card">
    <view class="switcher__tabs">
      <view class="switcher__tab {{ granularity === 'week' ? 'switcher__tab--active' : '' }}" data-type="week" bindtap="onGranularityChange">周</view>
      <view class="switcher__tab {{ granularity === 'month' ? 'switcher__tab--active' : '' }}" data-type="month" bindtap="onGranularityChange">月</view>
      <view class="switcher__tab {{ granularity === 'year' ? 'switcher__tab--active' : '' }}" data-type="year" bindtap="onGranularityChange">年</view>
    </view>
  </view>

  <view class="card period-scroll-card">
    <scroll-view scroll-x class="period-scroll" show-scrollbar="false">
      <view class="period-scroll__list">
        <block wx:if="{{ granularity === 'week' }}">
          <view wx:for="{{ weekOptions }}" wx:key="label" class="period-scroll__item {{ selectedWeekLabel === item.label ? 'period-scroll__item--active' : '' }}" bindtap="onWeekQuickPick" data-value="{{ item.value }}">{{ item.label }}</view>
        </block>
        <block wx:elif="{{ granularity === 'month' }}">
          <view wx:for="{{ monthOptions }}" wx:key="*this" class="period-scroll__item {{ selectedMonthLabel === item ? 'period-scroll__item--active' : '' }}" bindtap="onMonthQuickPick" data-month="{{ item }}">{{ item }}</view>
        </block>
        <block wx:else>
          <view wx:for="{{ yearOptions }}" wx:key="*this" class="period-scroll__item {{ selectedYearLabel === item ? 'period-scroll__item--active' : '' }}" bindtap="onYearQuickPick" data-year="{{ item }}">{{ item }}年</view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="card stats-chart-card">
    <view class="chart-metrics">
      <view class="chart-metric">
        <text class="chart-metric__label">{{ chartTotalLabel }}</text>
        <text class="chart-metric__value">{{ chartTotalDisplay }}</text>
      </view>
      <view class="chart-metric-divider"></view>
      <view class="chart-metric">
        <text class="chart-metric__label">平均值</text>
        <text class="chart-metric__value">{{ chartAvgDisplay }}</text>
      </view>
    </view>
    <view wx:if="{{ activePointIndex >= 0 }}" class="line-chart-tipbar">
      <text>{{ activePointLabel }}</text>
      <text>{{ activePointValue }}</text>
    </view>
    <canvas id="trendCanvas" canvas-id="trendCanvas" class="chart-canvas"></canvas>
  </view>

  <view class="card stats-pie-card">
    <view wx:if="{{ pieLevel === 'subCategory' }}" class="pie-breadcrumb">
      <text class="pie-breadcrumb__back" bindtap="onPieBack">‹ 返回大类</text>
      <text class="pie-breadcrumb__title">{{ pieParentCategoryName }}</text>
    </view>
    <view wx:if="{{ empty }}" class="empty-inline">暂无数据</view>
    <view wx:else>
      <view class="pie-ring-wrap">
        <canvas id="pieCanvas" canvas-id="pieCanvas" class="pie-canvas"></canvas>
        <view class="pie-label-layer">
          <view
            wx:for="{{ pieLabels }}"
            wx:key="id"
            class="pie-label {{ item.labelAlign === 'left' ? 'pie-label--left' : 'pie-label--right' }}"
            style="left: {{ item.labelLeft }}px; top: {{ item.labelTop }}px; border-color: {{ item.color }}22;"
            bindtap="onPieLabelTap"
            data-id="{{ item.id }}"
          >
            <view class="pie-label__title">
              <view class="pie-label__dot" style="background: {{ item.color }};"></view>
              <text class="pie-label__name">{{ item.name }}</text>
            </view>
            <view class="pie-label__meta">
              <text class="pie-label__money">{{ item.amountDisplay }}</text>
              <text class="pie-label__percent">{{ item.percent }}%</text>
            </view>
          </view>
        </view>
        <view class="pie-center">
          <text class="pie-center__value">{{ pieCenterValue }}</text>
          <text class="pie-center__label">{{ pieCenterLabel }}</text>
        </view>
      </view>
      <view class="pie-legend-hint">点击分类名称可下钻查看支出小类</view>
    </view>
  </view>
</view>
