.stats-page { padding-bottom: 24rpx; }
.stats-header { padding: 24rpx 24rpx 20rpx; background: linear-gradient(180deg, rgba(7, 193, 96, 0.08) 0%, rgba(7, 193, 96, 0.02) 100%); border: 1rpx solid rgba(7, 193, 96, 0.08); }
.stats-header--tall { padding-bottom: 18rpx; }
.stats-header__topline { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 14rpx; }
.stats-header__secondline { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.stats-header__title { line-height: 1; font-size: 34rpx; }
.stats-meta { display: flex; align-items: baseline; gap: 16rpx; flex-wrap: wrap; }
.stats-header__sub { font-size: 24rpx; color: var(--color-text-secondary); }
.stats-top-switch { display: flex; background: #f7f8fa; border-radius: 999rpx; padding: 6rpx; gap: 6rpx; box-shadow: inset 0 0 0 1rpx rgba(0,0,0,0.02); }
.stats-top-switch__item { padding: 12rpx 22rpx; border-radius: 999rpx; font-size: 24rpx; color: var(--color-text-secondary); }
.stats-top-switch__item--active { background: #fff; color: var(--color-primary); font-weight: 600; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06); }
.filter-trigger { display: inline-flex; align-items: center; gap: 6rpx; padding: 10rpx 16rpx; border-radius: 999rpx; background: #f7f8fa; color: var(--color-text); }
.filter-trigger__text { font-size: 28rpx; font-weight: 600; }
.filter-trigger__arrow { font-size: 20rpx; color: var(--color-text-secondary); }
.stats-switcher-card { padding: 14rpx 20rpx; }
.switcher__tabs { display: flex; background: #f7f8fa; border-radius: 999rpx; padding: 8rpx; gap: 8rpx; }
.switcher__tab { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 999rpx; color: var(--color-text-secondary); }
.switcher__tab--active { background: #fff; color: var(--color-primary); font-weight: 600; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06); }
.period-scroll-card { padding: 14rpx 0 10rpx; overflow: hidden; }
.period-scroll { width: 100%; white-space: nowrap; }
.period-scroll__list { display: flex; flex-direction: row; flex-wrap: nowrap; gap: 14rpx; padding: 0 12rpx 8rpx; width: max-content; min-width: 100%; }
.period-scroll__item { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; min-width: 88rpx; height: 54rpx; padding: 0 18rpx; box-sizing: border-box; border-radius: 999rpx; background: #f7f8fa; color: var(--color-text-secondary); font-size: 24rpx; white-space: nowrap; border: 1rpx solid transparent; }
.period-scroll__item--active { background: rgba(7, 193, 96, 0.12); color: var(--color-primary); font-weight: 600; border-color: rgba(7, 193, 96, 0.28); box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.08); }
.stats-chart-card,
.stats-pie-card { padding-top: 22rpx; }
.stat-subtitle { display: block; margin-top: -4rpx; margin-bottom: 22rpx; }
.empty-inline { padding: 48rpx 0; text-align: center; color: var(--color-text-secondary); }
.line-chart-tipbar { display: flex; justify-content: space-between; margin-bottom: 16rpx; padding: 14rpx 20rpx; border-radius: 16rpx; background: #f7f8fa; color: var(--color-text-secondary); font-size: 24rpx; }
.chart-canvas { width: 100%; height: 420rpx; }
.pie-ring-wrap { position: relative; width: 100%; height: 460rpx; }
.pie-canvas { width: 100%; height: 460rpx; }
.pie-label-layer { position: absolute; inset: 0; pointer-events: none; }
.pie-label { position: absolute; transform: translateY(-50%); max-width: 240rpx; padding: 10rpx 12rpx; border-radius: 16rpx; background: rgba(255,255,255,0.9); box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); pointer-events: auto; }
.pie-label--left { transform: translate(-100%, -50%); }
.pie-label--right { transform: translate(0, -50%); }
.pie-label__title { display: flex; align-items: center; gap: 8rpx; }
.pie-label__dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.pie-label__name { font-size: 24rpx; color: var(--color-text); }
.pie-label__meta { display: flex; align-items: center; gap: 10rpx; margin-top: 6rpx; }
.pie-label__money { font-size: 22rpx; font-weight: 600; color: var(--color-text); }
.pie-label__percent { font-size: 20rpx; color: var(--color-text-secondary); }
.pie-center { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 160rpx; height: 160rpx; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; background: rgba(255,255,255,0.92); }
.pie-center__value { font-size: 30rpx; font-weight: 700; color: var(--color-text); line-height: 1.1; }
.pie-center__label { margin-top: 8rpx; font-size: 20rpx; color: var(--color-text-secondary); }
.pie-breadcrumb { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; padding: 12rpx 16rpx; border-radius: 18rpx; background: #f7f8fa; }
.pie-breadcrumb__back { font-size: 24rpx; color: var(--color-primary); font-weight: 600; }
.pie-breadcrumb__title { font-size: 24rpx; color: var(--color-text-secondary); }
.pie-legend-hint { margin-top: 6rpx; font-size: 22rpx; color: var(--color-text-secondary); text-align: center; }
