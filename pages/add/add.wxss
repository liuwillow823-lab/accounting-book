.amount-section {
  text-align: center;
  padding: 48rpx 32rpx 56rpx;
}

.amount-section__label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
}

.amount-section__input-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.amount-section__symbol {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-text);
}

.amount-section__input {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--color-text);
  height: 100rpx;
  min-width: 200rpx;
  text-align: left;
}

.amount-section__placeholder {
  color: #dcdee0;
  font-weight: 700;
}

.form {
  padding: 0 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.form-row--last {
  border-bottom: none;
}

.form-row__label {
  font-size: 28rpx;
  color: var(--color-text);
  flex-shrink: 0;
  width: 100rpx;
}

.form-row__value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.form-row__arrow {
  color: var(--color-text-secondary);
  font-size: 32rpx;
}

.form-row__input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--color-text);
}

.type-switch__tabs {
  display: flex;
  background: #f7f8fa;
  border-radius: 999rpx;
  padding: 8rpx;
}

.type-switch__tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.type-switch__tab--active {
  background: #fff;
  color: var(--color-primary);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  font-weight: 600;
}

.amount-section__symbol {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-text);
}

.actions {
  margin-top: 48rpx;
  padding: 0 16rpx;
}

.btn-link,
.btn-delete {
  margin-top: 24rpx;
  background: transparent !important;
  border: none !important;
  font-size: 28rpx !important;
}

.btn-link {
  color: var(--color-primary) !important;
}

.btn-delete {
  color: var(--color-danger) !important;
}
