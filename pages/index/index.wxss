.hero {
  text-align: center;
  padding: 22rpx 32rpx 26rpx;
  background: linear-gradient(180deg, rgba(7, 193, 96, 0.08) 0%, rgba(7, 193, 96, 0.02) 100%);
  border: 1rpx solid rgba(7, 193, 96, 0.08);
  color: var(--color-text);
  box-shadow: var(--shadow-card);
}

.hero__label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.hero__stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero__stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero__stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 6rpx;
}

.hero__stat-amount {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hero__stat-amount--income {
  color: var(--color-primary);
}

.hero__stat-amount--expense {
  color: var(--color-danger);
}

.hero__divider {
  width: 1rpx;
  align-self: stretch;
  background: var(--color-border);
}

.btn-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: -28rpx 48rpx 32rpx;
  background: #fff;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  border-radius: 48rpx;
  box-shadow: var(--shadow-card);
  border: none;
}

.btn-add__icon { font-size: 40rpx; font-weight: 400; }
.section { margin-top: 8rpx; }
.section-header { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx 16rpx; }
.section-link { font-size: 26rpx; color: var(--color-text-secondary); }
.empty-inline { padding: 48rpx 32rpx; text-align: center; }
.list-card { padding: 0 32rpx; }
.txn-item { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; border-bottom: 1rpx solid var(--color-border); }
.txn-item:last-child { border-bottom: none; }
.txn-item__left { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; }
.txn-item__icon { font-size: 40rpx; width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center; background: var(--color-primary-light); border-radius: 50%; flex-shrink: 0; }
.txn-item__info { display: flex; flex-direction: column; min-width: 0; }
.txn-item__cat { font-size: 28rpx; color: var(--color-text); }
.txn-item__remark { font-size: 24rpx; color: var(--color-text-secondary); margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.txn-item__amount { font-size: 32rpx; font-weight: 600; color: var(--color-text); flex-shrink: 0; margin-left: 16rpx; }
.txn-item__amount--income { color: var(--color-primary); }
.fab { position: fixed; right: 40rpx; bottom: calc(120rpx + env(safe-area-inset-bottom)); width: 104rpx; height: 104rpx; background: var(--color-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.45); z-index: 100; }
.fab__icon { color: #fff; font-size: 52rpx; font-weight: 300; line-height: 1; }
