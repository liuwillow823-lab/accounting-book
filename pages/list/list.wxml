<view class="container">
  <!-- 月份选择 + 汇总 -->
  <view class="summary card">
    <view class="summary__top">
      <view
        class="month-bar__arrow {{ canGoPrev ? '' : 'month-bar__arrow--disabled' }}"
        bindtap="onPrevMonth"
      >‹</view>

      <picker mode="date" fields="month" value="{{ selectedMonth }}-01" start="{{ pickerStart }}-01" end="{{ pickerEnd }}-01" bindchange="onMonthPick">
        <view class="month-bar__center">
          <text class="month-bar__label">{{ monthLabel }}</text>
          <text class="month-bar__hint">▼</text>
        </view>
      </picker>

      <view
        class="month-bar__arrow {{ canGoNext ? '' : 'month-bar__arrow--disabled' }}"
        bindtap="onNextMonth"
      >›</view>
    </view>

    <view class="summary__row">
      <text class="summary__amount summary__amount--income">收 {{ incomeTotalDisplay }}</text>
      <text class="summary__amount summary__amount--expense">支 {{ expenseTotalDisplay }}</text>
      <text class="summary__count">共 {{ totalCount }} 笔</text>
    </view>
  </view>

  <!-- 空状态：从未记账 -->
  <view wx:if="{{ !hasAnyTransaction }}" class="empty-state">
    <text class="empty-state__icon">📝</text>
    <text class="empty-state__text">还没有任何账单</text>
    <button class="btn-primary" style="width: 320rpx;" bindtap="goAdd">记第一笔</button>
  </view>

  <!-- 空状态：该月无账单 -->
  <view wx:elif="{{ groups.length === 0 }}" class="empty-state">
    <text class="empty-state__icon">📅</text>
    <text class="empty-state__text">{{ monthLabel }}还没有账单</text>
    <button class="btn-primary" style="width: 320rpx;" bindtap="goAdd">记一笔</button>
  </view>

  <!-- 按日分组列表 -->
  <block wx:else>
    <view wx:for="{{ groups }}" wx:key="date" class="group">
      <view class="group__header">
        <text class="group__date">{{ item.dateLabel }}</text>
        <text class="group__total">收 {{ item.incomeDisplay }}  支 {{ item.expenseDisplay }}</text>
      </view>

      <view class="card group__list">
        <view
          wx:for="{{ item.items }}"
          wx:for-item="txn"
          wx:key="id"
          class="txn-item"
          bindtap="goEdit"
          data-id="{{ txn.id }}"
        >
          <view class="txn-item__left">
            <text class="txn-item__icon">{{ txn.categoryIcon }}</text>
            <view class="txn-item__info">
              <text class="txn-item__cat">{{ txn.categoryName }} · {{ txn.subCategoryName }}</text>
              <text wx:if="{{ txn.remark }}" class="txn-item__remark">{{ txn.remark }}</text>
            </view>
          </view>
          <text class="txn-item__amount {{ txn.type === 'income' ? 'txn-item__amount--income' : '' }}">{{ txn.amountSign }}{{ txn.amountDisplay }}</text>
        </view>
      </view>
    </view>
  </block>
</view>
