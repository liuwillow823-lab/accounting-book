<view class="container">
  <!-- 用户信息头部 -->
  <view class="card profile-header">
    <block wx:if="{{ loggedIn }}">
      <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onAvatarChoose">
        <image wx:if="{{ avatarUrl }}" class="profile-avatar-img" src="{{ avatarUrl }}" mode="aspectFill" />
        <view wx:else class="profile-avatar profile-avatar--login">✓</view>
      </button>
    </block>
    <view wx:else class="profile-avatar">👤</view>

    <view class="profile-info">
      <block wx:if="{{ loggedIn }}">
        <input class="profile-name-input" type="nickname" value="{{ nickName }}" placeholder="点击设置昵称" bindblur="onNickChange" />
        <text class="profile-sub">点击头像、昵称可修改</text>
      </block>
      <block wx:else>
        <text class="profile-name">点击登录</text>
        <text class="profile-sub">登录后可开启云端账本</text>
      </block>
    </view>
  </view>

  <!-- 未登录时显示登录入口 -->
  <view wx:if="{{ !loggedIn }}" class="card login-card">
    <button class="btn-primary btn-login" loading="{{ loginLoading }}" bindtap="onLogin">微信一键登录</button>
    <text class="login-tip">不登录也可以正常记账，登录后你的账本可在多台设备上同步</text>
  </view>

  <!-- 菜单 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="onSyncTip">
      <text class="menu-item__icon">📊</text>
      <text class="menu-item__text">云端账本</text>
      <text class="menu-item__tag">敬请期待</text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-item__icon">ℹ️</text>
      <text class="menu-item__text">关于本小程序</text>
      <text class="menu-item__arrow">›</text>
    </view>
  </view>
</view>