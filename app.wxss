/** 全局样式变量与通用类 */

page {
  --color-primary: #07c160;
  --color-primary-light: #e8f8ef;
  --color-danger: #ee0a24;
  --color-text: #323233;
  --color-text-secondary: #969799;
  --color-border: #ebedf0;
  --color-bg: #f5f6f8;
  --color-card: #ffffff;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --shadow-card: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);

  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.container {
  padding: 24rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-primary {
  color: var(--color-primary);
}

.amount-lg {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: -1rpx;
}

.btn-primary {
  background: var(--color-primary) !important;
  color: #fff !important;
  border: none !important;
  border-radius: 48rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
}

.btn-primary[disabled] {
  opacity: 0.5 !important;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  color: var(--color-text-secondary);
}

.empty-state__icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-state__text {
  font-size: 28rpx;
  margin-bottom: 32rpx;
}
