<view class="picker-trigger" bindtap="onOpen">
  <view class="picker-trigger__left">
    <text class="picker-trigger__icon">{{ selectedIcon }}</text>
    <view class="picker-trigger__info">
      <text class="picker-trigger__label">分类</text>
      <text class="picker-trigger__value">{{ selectedLabel || '请选择分类' }}</text>
    </view>
  </view>
  <text class="picker-trigger__arrow">›</text>
</view>

<!-- 两级选择弹层 -->
<view class="picker-mask {{ visible ? 'picker-mask--show' : '' }}" bindtap="onClose" catchtouchmove="preventMove">
  <view class="picker-panel {{ visible ? 'picker-panel--show' : '' }}" catchtap="preventMove">
    <view class="picker-panel__header">
      <text class="picker-panel__title">选择分类</text>
      <text class="picker-panel__close" bindtap="onClose">✕</text>
    </view>

    <view class="picker-panel__body">
      <scroll-view wx:if="{{ type === 'expense' }}" scroll-y class="picker-cats">
        <view
          wx:for="{{ categories }}"
          wx:key="id"
          class="picker-cats__item {{ activeCategoryId === item.id ? 'picker-cats__item--active' : '' }}"
          data-id="{{ item.id }}"
          bindtap="onSelectCategory"
        >
          <text class="picker-cats__icon">{{ item.icon }}</text>
          <text class="picker-cats__name">{{ item.name }}</text>
        </view>
      </scroll-view>

      <scroll-view scroll-y class="picker-subs {{ type === 'income' ? 'picker-subs--income' : '' }}">
        <view wx:if="{{ type === 'income' }}" class="income-grid">
          <view
            wx:for="{{ categories }}"
            wx:key="id"
            class="income-grid-item {{ categoryId === item.id ? 'income-grid-item--active' : '' }}"
            data-id="{{ item.id }}"
            bindtap="onSelectCategory"
          >
            <text class="income-grid-item__icon">{{ item.icon }}</text>
            <text class="income-grid-item__name">{{ item.name }}</text>
          </view>
        </view>
        <view wx:else>
          <view
            wx:for="{{ activeSubCategories }}"
            wx:key="id"
            class="picker-subs__item"
            data-category-id="{{ activeCategoryId }}"
            data-sub-id="{{ item.id }}"
            bindtap="onSelectSub"
          >
            <text>{{ item.name }}</text>
            <text wx:if="{{ categoryId === activeCategoryId && subCategoryId === item.id }}" class="picker-subs__check">✓</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
