.picker-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.picker-trigger__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.picker-trigger__icon {
  font-size: 44rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: var(--color-primary-light);
  border-radius: 50%;
}

.picker-trigger__info {
  display: flex;
  flex-direction: column;
}

.picker-trigger__label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.picker-trigger__value {
  font-size: 30rpx;
  color: var(--color-text);
}

.picker-trigger__arrow {
  font-size: 36rpx;
  color: var(--color-text-secondary);
}

.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.25s;
}

.picker-mask--show {
  background: rgba(0, 0, 0, 0.45);
  pointer-events: auto;
}

.picker-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  transform: translateY(100%);
  transition: transform 0.25s;
  display: flex;
  flex-direction: column;
}

.picker-panel--show {
  transform: translateY(0);
}

.picker-panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.picker-panel__title {
  font-size: 32rpx;
  font-weight: 600;
}

.picker-panel__close {
  font-size: 36rpx;
  color: var(--color-text-secondary);
  padding: 8rpx;
}

.picker-panel__body {
  display: flex;
  flex: 1;
  min-height: 400rpx;
  max-height: 60vh;
}

.picker-subs--income {
  width: 100%;
}

.income-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx;
}

.picker-cats {
  width: 240rpx;
  background: #f7f8fa;
}

.picker-cats__item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 28rpx 20rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.picker-cats__item--active {
  background: #fff;
  color: var(--color-primary);
  font-weight: 600;
}

.picker-cats__icon {
  font-size: 32rpx;
}

.picker-subs {
  flex: 1;
  background: #fff;
}

.picker-subs__empty {
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.income-grid-item {
  width: calc(50% - 8rpx);
  min-height: 128rpx;
  border-radius: 18rpx;
  background: #f7f8fa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.income-grid-item--active {
  background: var(--color-primary-light);
  border: 1rpx solid rgba(7, 193, 96, 0.2);
}

.income-grid-item__icon {
  font-size: 40rpx;
}

.income-grid-item__name {
  font-size: 26rpx;
  color: var(--color-text);
}

.picker-subs__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.picker-subs__check {
  color: var(--color-primary);
  font-weight: 700;
}
